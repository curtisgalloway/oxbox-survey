# Vendor-authored prose is stripped from archived catalogs before they are
# committed. The archive exists so a claim about a paid or delisted model stays
# checkable -- that needs ids, pricing and capability fields, all of which are
# facts. `description` is marketing copy written by the vendor, it is theirs,
# and this repo cannot relicense it: an Apache-2.0 grant over 300 KB of someone
# else's writing is a grant nobody here is able to make.
#
# Deliberately NOT stripped, having been measured rather than assumed:
#   links.details    a URL path ("/api/v1/models/<id>/endpoints"), not prose
#   privacy_comments ten distinct values across the whole roster, longest 73
#                    chars, mostly a URL or "N/A" -- factual, below any
#                    threshold of originality, and load-bearing for the survey's
#                    data-terms axis
REDACTED_FIELDS = ("description",)


def redact_vendor_prose(payload):
    """Strip vendor-authored prose from a raw catalog payload.

    Records the key as present-but-empty rather than deleting it, so a reader
    can tell "the venue published none" from "we removed it". A silently absent
    field would misrepresent the venue.
    """
    if not isinstance(payload, dict):
        return payload
    out = dict(payload)
    for key in ("data", "models"):
        rows = out.get(key)
        if not isinstance(rows, list):
            continue
        cleaned = []
        for row in rows:
            if not isinstance(row, dict):
                cleaned.append(row)
                continue
            row = dict(row)
            for field in REDACTED_FIELDS:
                if row.get(field):
                    row[field] = ""
            cleaned.append(row)
        out[key] = cleaned
    return out


# Fields carried into every snapshot record. A venue that cannot supply one
# writes None — never a guess, never an interpolation from a sibling field.
FIELDS = (
    "id",
    "canonical_slug",
    "name",
    "created",
    "context_length",
    "endpoint_context_length",
    "max_completion_tokens",
    "is_moderated",
    "input_modalities",
    "output_modalities",
    "supported_parameters",
    "expiration_date",
    "is_stealth",
    "free",
    # Data terms. Most catalogs carry these only as prose on a terms page, which
    # makes them Reported; Requesty publishes them as fields, which makes them
    # Measured for that venue. None means the venue does not say — never false.
    "trains_on_input",
    "data_retention_days",
)


def blank():
    return dict((f, None) for f in FIELDS)


def as_float(value):
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


# --------------------------------------------------------------------------
# Venue adapters
#
# Each parse_* takes the raw catalog payload and returns normalized records.
# Adding a venue means writing one of these and adding a VENUES entry; nothing
# else in the file should need to change.
# --------------------------------------------------------------------------


def parse_openrouter(payload):
    out = []
    for model in payload.get("data") or []:
        arch = model.get("architecture") or {}
        top = model.get("top_provider") or {}
        pricing = model.get("pricing") or {}
        mid = model.get("id", "")

        prompt = as_float(pricing.get("prompt"))
        completion = as_float(pricing.get("completion"))
        request_price = as_float(pricing.get("request"))
        # A request-priced model is not free even at zero per-token.
        free = (
            prompt == 0.0
            and completion == 0.0
            and not (request_price is not None and request_price > 0)
        )

        rec = blank()
        rec.update({
            "id": mid,
            "canonical_slug": model.get("canonical_slug"),
            "name": model.get("name"),
            "created": model.get("created"),
            "context_length": model.get("context_length"),
            "endpoint_context_length": top.get("context_length"),
            "max_completion_tokens": top.get("max_completion_tokens"),
            "is_moderated": top.get("is_moderated"),
            "input_modalities": sorted(arch.get("input_modalities") or []),
            "output_modalities": sorted(arch.get("output_modalities") or []),
            "supported_parameters": sorted(model.get("supported_parameters") or []),
            "expiration_date": model.get("expiration_date"),
            # The `stealth/` prefix is the venue's own marking, so this is
            # measured here. Other venues do not mark cloaked listings at all;
            # see the note in VENUES.
            "is_stealth": mid.startswith("stealth/"),
            "free": free,
        })
        out.append(rec)
    return out


def parse_zenmux(payload):
    """ZenMux nests pricing as {field: [{value, unit, currency}, ...]}."""
    out = []
    for model in payload.get("data") or []:
        pricings = model.get("pricings") or {}

        def values_for(key):
            found = []
            for row in pricings.get(key) or []:
                if isinstance(row, dict) and "value" in row:
                    v = as_float(row.get("value"))
                    if v is not None:
                        found.append(v)
            return found

        priced = values_for("prompt") + values_for("completion")
        free = bool(priced) and all(v == 0.0 for v in priced)

        rec = blank()
        rec.update({
            "id": model.get("id"),
            "name": model.get("display_name"),
            "created": model.get("created"),
            "context_length": model.get("context_length"),
            # ZenMux publishes one context figure; it is the served one, so
            # record it in both slots rather than leaving a false gap.
            "endpoint_context_length": model.get("context_length"),
            "input_modalities": sorted(model.get("input_modalities") or []),
            "output_modalities": sorted(model.get("output_modalities") or []),
            # ZenMux publishes `publish_time`, which is a listing date, not an
            # end date. There is no expiration field here; leave it None rather
            # than let a start date masquerade as one.
            "free": free,
        })
        out.append(rec)
    return out


def parse_requesty(payload):
    """Requesty prices in tiers and publishes data terms as fields."""
    out = []
    for model in payload.get("data") or []:
        tiers = model.get("pricing")
        if not isinstance(tiers, list) or not tiers:
            tiers = [{
                "input_price": model.get("input_price"),
                "output_price": model.get("output_price"),
            }]
        # Free only if EVERY tier is zero. A model that is free up to some
        # threshold and priced above it is not free.
        prices = []
        for tier in tiers:
            if not isinstance(tier, dict):
                continue
            for key in ("input_price", "output_price"):
                prices.append(as_float(tier.get(key)))
        free = bool(prices) and all(p == 0.0 for p in prices)

        # Requesty states capabilities as booleans rather than as a parameter
        # list. This renames them into the common vocabulary — a translation of
        # what the venue asserts, not an inference about what it supports.
        params = []
        if model.get("supports_tool_calling"):
            params.append("tools")
        if model.get("supports_reasoning"):
            params.append("reasoning")
        if model.get("supports_output_json_object") or model.get("supports_output_json_schema"):
            params.append("response_format")

        rec = blank()
        rec.update({
            "id": model.get("id"),
            "canonical_slug": model.get("model_canonical_name"),
            "created": model.get("created"),
            "context_length": model.get("context_window"),
            "endpoint_context_length": model.get("context_window"),
            "max_completion_tokens": model.get("max_output_tokens"),
            "supported_parameters": sorted(params),
            "free": free,
            "trains_on_input": model.get("data_used_for_training"),
            "data_retention_days": model.get("data_retention_days"),
        })
        out.append(rec)
    return out


def parse_openai_roster(payload):
    """A bare OpenAI-shaped /models list: id and created, no pricing.

    Used for class B venues. `free` stays None — unknown, not false.
    """
    out = []
    for model in payload.get("data") or []:
        rec = blank()
        rec.update({
            "id": model.get("id"),
            "created": model.get("created"),
        })
        out.append(rec)
    return out


