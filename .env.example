# Copy to .env and adjust vault/item names to match your 1Password.
# Values are op:// references, resolved at runtime by `op run --env-file .env -- <cmd>`.
# Never put a literal secret in either file; .env is gitignored, .env.example is not.
#
# The catalog fetch in `oxsurvey` needs NO key — every venue's model list is public.
# These are for actually calling a model, which happens in oxbox, not here.

OPENROUTER_API_KEY=op://<vault>/<openrouter item>/credential

# ZenMux issues two keys and they are not interchangeable:
#   PAYG     (sk-ai-…) — inference: /api/v1/chat/completions
#   Platform (sk-mg-…) — management: usage, billing, key administration
ZENMUX_API_KEY=op://<vault>/<zenmux payg item>/credential
ZENMUX_PLATFORM_API_KEY=op://<vault>/<zenmux platform item>/credential

# OpenCode Zen. Docs advertise /zen/v1/responses (OpenAI Responses API) and
# /zen/v1/messages (Anthropic-shaped) — NOT necessarily /chat/completions, which
# matters because ox posts chat completions. Verified route support is recorded in
# observations/.
OPENCODE_ZEN_API_KEY=op://<vault>/<opencode item>/credential

REQUESTY_API_KEY=op://<vault>/<requesty item>/credential
